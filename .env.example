# KawaifyPWA — environment variables (copy to .env.local for local dev)
#
# NEVER commit real secrets. Do not use API keys directly in React for production.

# Firebase (already required by the app — set in your Firebase project)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# --- Assistant / Gemini ---
# Server-only key (Cloud Function). Set via: firebase functions:secrets:set GEMINI_API_KEY
# Do NOT use VITE_GEMINI_API_KEY in the app.
# GEMINI_API_KEY=YOUR_API_KEY

# Frontend: HTTPS endpoint for assistantChat Cloud Function
VITE_ASSISTANT_API_URL=https://us-central1-kawaify-pwa.cloudfunctions.net/assistantChat
