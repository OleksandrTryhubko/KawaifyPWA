# KawaifyPWA — environment variables (copy to .env.local for local dev)
#
# NEVER commit real secrets. Do not use API keys directly in React for production.

# Firebase (already required by the app — set in your Firebase project)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# --- Assistant / Gemini (future — server-side only) ---
# Documented for Cloud Function setup. Do NOT wire VITE_GEMINI_API_KEY into UI code.
# Production flow: React → Firebase Auth → Cloud Function → Gemini API
VITE_GEMINI_API_KEY=YOUR_API_KEY

# Optional: HTTPS endpoint for assistant Cloud Function (when geminiEnabled in assistantConfig)
# VITE_ASSISTANT_API_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/assistantChat
